# Gitignore for LaTeX project in OPIT-RAI9001

# TeX intermediate files
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# PDF output
*.pdf

# Backup files
*~
*.bak

# Generated scripts/logs
*.run.xml

# Python cache (for scripts in workspace)
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# Environment variables
.env
.env.local
.env.*.local

# Docker volumes and data
src/neo4j/database/databases/
src/neo4j/database/transactions/
src/neo4j/database/dbms/
src/neo4j/backups/*.dump

# Data directories
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Model outputs
models/
outputs/
results/

# Temporary files
.tmp/
temp/
*.tmp

# IDE files
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Shell scripts logs
*.log
