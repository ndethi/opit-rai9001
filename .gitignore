# Gitignore for LaTeX project in OPIT-RAI9001

# TeX intermediate files
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bcf
*.run.xml

# PDF output (exclude globally but allow in thesis chapters)
*.pdf
!docs/thesis/chapters/*.pdf
!docs/thesis/*.pdf

# Backup files
*~
*.bak

# Python cache (for scripts in workspace)
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# Environment variables
.env
.env.local
.env.*.local

# Docker volumes and data - Neo4j runtime directories
src/neo4j/data/
src/neo4j/database/
src/neo4j/logs/
src/neo4j/backups/
src/neo4j/imports/*.csv
src/neo4j/imports/*.json
src/neo4j/imports/*.txt
# Neo4j plugins - exclude large JAR files
src/neo4j/plugins/*.jar
# Keep README files and sample imports
!src/neo4j/*/README.md
!src/neo4j/imports/sample-data/

# Data directories
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Model outputs
models/
outputs/
results/

# Temporary files
.tmp/
temp/
*.tmp

# IDE files
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Shell scripts logs
*.log
